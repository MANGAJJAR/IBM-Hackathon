# ==============================================================================
# BobPulse - IBM watsonx / Granite AI Configuration
# ==============================================================================
# Instructions:
# 1. Get your free IBM Cloud API key at: https://cloud.ibm.com/iam/apikeys
# 2. Find your watsonx project ID at: https://dataplatform.cloud.ibm.com/projects
# 3. Paste the values below and restart BobPulse (python run.py)
# ==============================================================================

# IBM Cloud / watsonx API Key
IBM_WATSONX_APIKEY=

# watsonx Project ID (UUID from project Manage -> General tab)
IBM_WATSONX_PROJECT_ID=

# Watsonx Service URL (Default: us-south. Change if your project is elsewhere)
# Options:
#   https://us-south.ml.cloud.ibm.com (Dallas)
#   https://eu-de.ml.cloud.ibm.com    (Frankfurt)
#   https://jp-tok.ml.cloud.ibm.com   (Tokyo)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
